# Application authentication
APP_USERNAME=your-login
APP_PASSWORD=use-a-long-unique-password
SESSION_SECRET=generate-at-least-32-random-characters

# PostgreSQL (keep private; never commit a real value)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Google AI Studio — Gemini 3.5 Flash
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash
# Optional override; the default is Google's official OpenAI-compatible endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
